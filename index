function choose(i){if(answers[index]!==null)return;answers[index]=i;paint();document.getElementById('next').disabled=false}
function paint(){const q=questions[index], els=[...document.querySelectorAll('.option')];els.forEach((e,i)=>{e.classList.add('disabled');if(i===q.answer)e.classList.add('correct');if(i===answers[index]&&i!==q.answer)e.classList.add('wrong')})}
function nextQ(){if(index<questions.length-1){index++;render()}else finish()} function prevQ(){if(index>0){index--;render()}}
function finish(){const n=questions.reduce((s,q,i)=>s+(answers[i]===q.answer),0),pct=Math.round(n/questions.length*100);document.getElementById('resultSubject').textContent=subject==='statistics'?'مادة الإحصاء':subject==='toxicology'?'مادة التسمم':'مادة الجهاز التنفسي';document.getElementById('score').textContent=`${n} / ${questions.length}`;document.getElementById('message').textContent=pct>=90?'ممتاز جدًا! إتقان رائع 🌟':pct>=75?'جيد جدًا، واصلي المراجعة 👏':pct>=60?'جيد، تحتاجين مراجعة بعض النقاط 📚':'راجعي المادة ثم أعيدي المحاولة 💪';const r=document.getElementById('review');r.innerHTML='<h3>مراجعة الإجابات غير الصحيحة</h3>';let wrong=0;questions.forEach((q,i)=>{if(answers[i]!==q.answer){wrong++;const d=document.createElement('div');d.className='review-item';d.innerHTML=`<b>${i+1}. ${q.q}</b><p>إجابتك: ${q.options[answers[i]]||'لم تتم الإجابة'}</p><p style="color:var(--good)">الصحيحة: ${q.options[q.answer]}</p>`;r.appendChild(d)}});if(!wrong)r.innerHTML='<h3>كل إجاباتك صحيحة 🎉</h3>';show('result')}
function restart(){startQuiz(subject)} function goHome(){show('home')}
</script></body></html>
